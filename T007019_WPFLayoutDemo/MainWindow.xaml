<Window x:Class="T007019_WPFLayoutDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T007019_WPFLayoutDemo"
        mc:Ignorable="d" 
        Background="#F5F6F8" Title="MainWindow" Height="450" Width="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel Margin="10" Orientation="Horizontal">
            <!-- 相机模块IO -->
            <Border Width="280" Margin="5" Background="White" CornerRadius="4" BorderThickness="1" BorderBrush="#DDD">
                <StackPanel Margin="10">
                    <TextBlock Text="相机模块" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse Width="10" Height="10" Fill="Green" Margin="0,0,4,0" />
                            <TextBlock Text="触发信号" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse Width="10" Height="10" Fill="Red" Margin="0,0,4,0" />
                            <TextBlock Text="采集完成" FontSize="12" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 运动模块IO -->
            <Border Width="280" Margin="5" Background="White" CornerRadius="4" BorderThickness="1" BorderBrush="#DDD">
                <StackPanel Margin="10">
                    <TextBlock Text="运动模块" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse Width="10" Height="10" Fill="Green" Margin="0,0,4,0" />
                            <TextBlock Text="原点信号" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse Width="10" Height="10" Fill="Green" Margin="0,0,4,0" />
                            <TextBlock Text="到位信号" FontSize="12" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </WrapPanel>
    </ScrollViewer>
</Window>
