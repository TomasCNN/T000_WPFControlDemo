<Window x:Class="T007007_WPFLayoutDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T007007_WPFLayoutDemo"
        mc:Ignorable="d" Title="生产监控大屏" Width="1350" Height="780" Background="#1E2936" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <!-- 顶部深色标题栏 -->
        <Border Grid.Row="0" Background="#273444">
            <TextBlock Text="智能产线监控大屏" Foreground="#00D8FF" FontSize="20" FontWeight="Bold" Margin="25,0" VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <!-- 左侧深色菜单 -->
                <Border Background="#273444" Margin="5">
                    <StackPanel Margin="10,20">
                        <Button Content="总览大屏" Height="44" Margin="0,0,0,10" Background="#38485C" Foreground="White" BorderThickness="0" />
                        <Button Content="产线状态" Height="44" Margin="0,0,0,10" Background="#38485C" Foreground="White" BorderThickness="0" />
                        <Button Content="报警信息" Height="44" Margin="0,0,0,10" Background="#38485C" Foreground="White" BorderThickness="0" />
                        <Button Content="数据分析" Height="44" Margin="0,0,0,10" Background="#38485C" Foreground="White" BorderThickness="0" />
                        <Button Content="系统配置" Height="44" Background="#38485C" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <!-- 中间大屏区域 -->
                <Border Margin="8" Background="#273444" CornerRadius="6">
                    <TextBlock Text="数据可视化大屏区域" Foreground="#00D8FF" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#273444">
            <TextBlock Text="  系统正常运行 | 数据采集已连接" Foreground="#ABB3BF" VerticalAlignment="Center" FontSize="12" />
        </Border>
    </Grid>
</Window>
