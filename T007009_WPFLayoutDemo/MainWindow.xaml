<Window x:Class="T007009_WPFLayoutDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T007009_WPFLayoutDemo"
        mc:Ignorable="d" Title="标签式主界面" Width="1200" Height="750" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- 顶部标签导航 -->
        <TabControl Grid.Row="0" TabStripPlacement="Top" Background="#F3F6FA">
            <TabItem Header="实时监控" />
            <TabItem Header="生产数据" />
            <TabItem Header="缺陷管理" />
            <TabItem Header="系统设置" />
        </TabControl>

        <!-- 主内容 -->
        <Border Grid.Row="1" Margin="10" Background="#FFFFFF" CornerRadius="6">
            <TextBlock Text="标签页对应内容区域" FontSize="22" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#F3F6FA">
            <TextBlock Text="  系统正常 | 版本 V1.0.0" VerticalAlignment="Center" FontSize="12" />
        </Border>
    </Grid>
</Window>
