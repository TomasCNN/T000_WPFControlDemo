<Window x:Class="T007023_WPFLayoutCanvasDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T007023_WPFLayoutCanvasDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Canvas Margin="20" Background="White" Width="760" Height="360">
            <!-- 上料工位：坐标(0,140) -->
            <Border Width="120" Height="80" Background="#E3F2FD" CornerRadius="4" Canvas.Left="0" Canvas.Top="140">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="上料工位" FontWeight="Bold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="Green" Margin="0,0,3,0" />
                        <TextBlock Text="有料" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 传送带：坐标(120,170) -->
            <Border Height="20" Background="#90CAF9" Width="520" Canvas.Left="120" Canvas.Top="170" />

            <!-- 检测工位：坐标(320,140) -->
            <Border Width="120" Height="80" Background="#E8F5E9" CornerRadius="4" Canvas.Left="320" Canvas.Top="140">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="检测工位" FontWeight="Bold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="Red" Margin="0,0,3,0" />
                        <TextBlock Text="检测中" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 下料工位：坐标(640,140) -->
            <Border Width="120" Height="80" Background="#FFF3E0" CornerRadius="4" Canvas.Left="640" Canvas.Top="140">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="下料工位" FontWeight="Bold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="Green" Margin="0,0,3,0" />
                        <TextBlock Text="空闲" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>

    </Grid>
</Window>
