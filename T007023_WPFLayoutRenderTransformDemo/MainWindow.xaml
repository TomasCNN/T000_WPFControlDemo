<Window x:Class="T007023_WPFLayoutRenderTransformDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T007023_WPFLayoutRenderTransformDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20" Background="White">
        <!-- 传送带 -->
        <Border Height="20" Background="#90CAF9" Margin="120,0,120,0" VerticalAlignment="Center" />

        <!-- 上料工位 -->
        <!--Margin:左/上/右/下-->
        <Border Width="120" Height="80" Background="#E3F2FD" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="上料工位" FontWeight="Bold" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="Green" Margin="0,0,3,0" />
                    <TextBlock Text="有料" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 检测工位：用TranslateTransform向上偏移10px -->
        <Border Width="120" Height="80" Background="#E8F5E9" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform />
                    <TranslateTransform Y="-10" />
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="检测工位" FontWeight="Bold" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="Red" Margin="0,0,3,0" />
                    <TextBlock Text="检测中" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 下料工位 -->
        <Border Width="120" Height="80" Background="#FFF3E0" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="下料工位" FontWeight="Bold" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="Green" Margin="0,0,3,0" />
                    <TextBlock Text="空闲" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
