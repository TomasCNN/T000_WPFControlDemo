<Window x:Class="T007017_WPFLayoutDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T007017_WPFLayoutDemo"
        mc:Ignorable="d"
        Title="登陆系统" Height="450" Width="800">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="智能视觉检测系统" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 30" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="用户名:" />
                <TextBox Grid.Row="0" Grid.Column="1" Height="28" />

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="密码:" />
                <PasswordBox Grid.Row="1" Grid.Column="1" Height="28" />
            </Grid>

            <Button Content="登录" Height="35" Margin="0 30 0 0" Background="#1976D2" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
