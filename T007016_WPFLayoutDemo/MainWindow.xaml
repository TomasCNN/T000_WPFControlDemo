<Window x:Class="T007016_WPFLayoutDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T007016_WPFLayoutDemo"
        mc:Ignorable="d"
        Title="确认" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="⚠️" FontSize="32" Margin="0 0 15 0" />
            <TextBlock Text="确定要删除选中的记录吗？此操作不可恢复。" TextWrapping="Wrap" FontSize="14" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Height="30" Margin="0 0 10 0" Background="#D32F2F" Foreground="White" />
            <Button Content="取消" Width="80" Height="30" />
        </StackPanel>
    </Grid>
</Window>
