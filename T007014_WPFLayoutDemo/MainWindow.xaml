<Window x:Class="T007014_WPFLayoutDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T007014_WPFLayoutDemo"
        mc:Ignorable="d" 
        Title="IO 监控" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Background="#F5F5F5" CornerRadius="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10 0">
                <Button Content="刷新" Width="60" Height="25" Margin="0 0 10 0" />
                <Button Content="全部清零" Width="80" Height="25" />
            </StackPanel>
        </Border>

        <!-- 中间IO状态 -->
        <TabControl Grid.Row="1" Margin="0 10 0 0">
            <TabItem Header="输入信号">
                <UniformGrid Rows="8" Columns="8" Margin="10">
                    <!-- 输入点1-32 -->
                    <Border Margin="3" Background="#E8F5E9" CornerRadius="3">
                        <TextBlock Text="IN00" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Border>
                    <Border Margin="3" Background="#E8F5E9" CornerRadius="3">
                        <TextBlock Text="IN01" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Border>
                    <Border Margin="3" Background="#FFEBEE" CornerRadius="3">
                        <TextBlock Text="IN02" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Border>
                    <Border Margin="3" Background="#E8F5E9" CornerRadius="3">
                        <TextBlock Text="IN03" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Border>
                    <!-- 重复添加到32个输入点 -->
                </UniformGrid>
            </TabItem>

            <TabItem Header="输出信号">
                <UniformGrid Rows="4" Columns="8" Margin="10">
                    <!-- 输出点1-16 -->
                    <Border Margin="3" Background="#E8F5E9" CornerRadius="3">
                        <TextBlock Text="OUT00" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Border>
                    <Border Margin="3" Background="#FFEBEE" CornerRadius="3">
                        <TextBlock Text="OUT01" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Border>
                    <!-- 重复添加到16个输出点 -->
                </UniformGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
